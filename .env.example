# Copy to .env.local for local dev with `vercel dev`, or set in Vercel dashboard for production.

# Where the order emails are delivered.
RECEPTION_EMAIL=reception@calista.lk

# Resend API key (https://resend.com — free tier: 3000 emails/month).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: customise the "From" address.
# Free Resend accounts must use the onboarding sender. To send from @calista.lk,
# verify your domain in the Resend dashboard first.
RESEND_FROM_EMAIL=Calista Orders <onboarding@resend.dev>
